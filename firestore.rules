rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function validUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2000
        && value.matches('https?://.+');
    }

    function validBook(data) {
      return data.keys().hasAll([
          'title', 'author', 'genre', 'coverUrl', 'readUrl', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'title', 'author', 'isbn', 'year', 'genre', 'description',
          'coverUrl', 'readUrl', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 180
        && data.author is string && data.author.size() > 0 && data.author.size() <= 160
        && data.genre is string && data.genre.size() > 0 && data.genre.size() <= 80
        && validUrl(data.coverUrl)
        && validUrl(data.readUrl)
        && data.createdBy is string
        && (!('isbn' in data) || (data.isbn is string && data.isbn.size() <= 32))
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('year' in data) || data.year == null || (data.year is int && data.year >= 1000 && data.year <= 2100))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Admin records must be provisioned manually in Firebase Console.
    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Public catalog reading; only verified admins can modify books.
    match /books/{bookId} {
      allow read: if true;
      allow create: if isAdmin()
        && validBook(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && validBook(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Users can access only their own data.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
